{
	"private": true,
	"name": "image-downloader",
	"version": "4.6.0",
	"license": "GPLv3",
	"scripts": {
		"dev": "bun start",
		"web": "bun --watch scripts/web.ts",
		"bun remote": "bun code & bun tailscale",
		"code": "code-server --port=4095",
		"tailscale": "tailscale serve reset && tailscale serve --bg --http=3001 3000 && tailscale serve --bg --http=4096 4095",
		"start": "bun run build && bun scripts/watch.ts",
		"build": "bun scripts/build.ts && bun run build:zip",
		"build:zip": "rm -f ../image-downloader.zip ../image-downloader-firefox.zip && (cd build && zip -qr ../../image-downloader.zip .) && (cd build-firefox && zip -qr ../../image-downloader-firefox.zip .)",
		"task": "bun scripts/task.ts",
		"test": "bun test",
		"lint": "bunx prettier --write .",
		"types": "bun check"
	},
	"devDependencies": {
		"@preact/signals": "^2.11.3",
		"@preact/signals-core": "^1.14.4",
		"@tailwindcss/cli": "4.3.3",
		"@types/bun": "1.4.3",
		"@types/chrome": "0.3.5",
		"@types/fs-extra": "^11.0.4",
		"@types/glob-watcher": "^5.0.5",
		"fs-extra": "11.4.1",
		"glob": "13.0.6",
		"glob-watcher": "6.0.0",
		"happy-dom": "21.0.3",
		"htm": "^3.1.1",
		"nouislider": "^15.8.1",
		"preact": "11.0.1",
		"prettier": "3.9.10",
		"prettier-plugin-tailwindcss": "0.8.1",
		"sharp": "0.35.5",
		"sneer": "1.0.1",
		"tailwindcss": "4.3.3"
	}
}
